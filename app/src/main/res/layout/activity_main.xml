<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#6C5CE7"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Number Guess"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guess a number (1-100)"
            android:textColor="#2D3436"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/guessInput"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:hint="Your guess"
            android:inputType="number"
            android:textColor="#2D3436"
            android:textColorHint="#B2BEC3"
            android:textSize="24sp" />

        <Button
            android:id="@+id/guessButton"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#00B894"
            android:text="Guess"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="You have 7 attempts"
            android:textColor="#6C5CE7"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/restartButton"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#FD79A8"
            android:text="New Game"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>